# ============================================================
# Plantilla de entorno — copia este archivo a .env
#
#   cp .env.example .env
#   php artisan key:generate
#   php artisan migrate --seed
#
# O en un solo paso:  composer setup
# ============================================================

APP_NAME="Policlínica Ahuachapaneca API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Zona horaria: crítica para agenda, hora_llegada y orden de atención.
APP_TIMEZONE=America/El_Salvador
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

# ─── Base de datos ──────────────────────────────────────────
# Hay dos opciones. Deja activa solo una.

# OPCIÓN A (por defecto) — SQLite.
# Cero configuración: no requiere servidor de base de datos, ni usuario, ni
# contraseña, ni Tailscale. `php artisan migrate` crea el archivo solo.
# Es la opción para quien trabaja en frontend o diseño y solo necesita que la
# API responda. Cada quien tiene su propia copia, así que nadie pisa a nadie.
DB_CONNECTION=sqlite

# OPCIÓN B — MariaDB compartida (vía Tailscale).
# Base común del equipo, igual que producción. Úsala cuando necesites que
# todos vean los mismos datos, o cuando trabajes en agenda/citas: la
# concurrencia de RB-07 depende de transacciones y bloqueos de fila que
# SQLite maneja distinto.
#
# Requiere Tailscale conectado. Pide el usuario y la contraseña a Dennis —
# NO se escriben en este archivo, que sí se sube al repositorio.
#
# ⚠  Es una base COMPARTIDA: `migrate:fresh` y `composer fresh` borran los
#    datos de todo el equipo, no solo los tuyos. Avisa antes de usarlos.
#
# DB_CONNECTION=mariadb
# DB_HOST=100.64.0.1
# DB_PORT=3306
# DB_DATABASE=policlinica_ahuachapaneca
# DB_USERNAME=
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# ─── Seguridad / autenticación ──────────────────────────────
BCRYPT_ROUNDS=12
SANCTUM_TOKEN_PREFIX=pcah_
AUTH_TOKEN_EXPIRATION=480

# ─── Sesión, caché y colas ──────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

# ─── Logs ───────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Correo (sin usar aún; 'log' escribe a storage/logs) ────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@policlinica.com"
MAIL_FROM_NAME="${APP_NAME}"
