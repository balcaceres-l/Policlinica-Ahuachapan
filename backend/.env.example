# ============================================================
# Plantilla de entorno — copia este archivo a .env
#
#   cp .env.example .env
#   php artisan key:generate
#
# El equipo trabaja contra UNA sola base de datos, la de MariaDB en el
# servidor del equipo. Requiere Tailscale conectado y las credenciales,
# que se piden a Dennis y NO se escriben aquí: este archivo se sube.
#
# NO ejecutes `php artisan migrate --seed` ni `composer setup` contra esa
# base: ya está migrada y sembrada. Solo `php artisan migrate` si hay
# migraciones nuevas.
# ============================================================

APP_NAME="Policlínica Ahuachapaneca API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Zona horaria: crítica para agenda, hora_llegada y orden de atención.
APP_TIMEZONE=America/El_Salvador
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

# ─── Base de datos ──────────────────────────────────────────
# Base única del equipo, en el servidor MariaDB al que se llega por
# Tailscale. Pide usuario y contraseña a Dennis; no van en este archivo.
#
# ⚠  Es COMPARTIDA. `migrate:fresh`, `migrate:refresh` y `db:seed` afectan
#    a todo el equipo, no solo a ti. `migrate` a secas es seguro.
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ─── Seguridad / autenticación ──────────────────────────────
BCRYPT_ROUNDS=12
SANCTUM_TOKEN_PREFIX=pcah_

# ─── Reglas de agenda ───────────────────────────────────────
# Minutos de tolerancia antes de marcar la cita como retrasada (RF-44).
CITA_RETRASO_PACIENTE_MIN=10
CITA_DURACION_BLOQUE_MIN=30
AUTH_TOKEN_EXPIRATION=480

# ─── Sesión, caché y colas ──────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

# ─── Logs ───────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Correo (en local usa 'log' para escribir a storage/logs/laravel.log; en producción usa 'smtp' con cPanel) ────
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@policlinica.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── API de la OMS para la CIE-11 (HU-44) ────────────────────
# Credenciales en https://icd.who.int/icdapi ("View API access key"). Nunca en el frontend.
# Desarrollo: servidor de pruebas sin autenticación.
ICD_API_URL=https://icd11restapi-developer-test.azurewebsites.net
ICD_API_SECURED=false
# Producción: ICD_API_URL=https://id.who.int e ICD_API_SECURED=true, con las credenciales.
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=
ICD_PROXY_MINUTOS=15
ICD_PROXY_LIMITE=240
