# ============================================================
# Policlínica Ahuachapaneca — API (PRODUCCIÓN cPanel CloudLinux)
# ============================================================
# INSTRUCCIONES EN EL SERVIDOR cPanel:
#   1. Copia este archivo a .env:
#      cp .env.production.example .env
#   2. Si no tienes APP_KEY generada, ejecuta:
#      php artisan key:generate
#   3. Ingresa el nombre de base de datos, usuario y clave creados en cPanel MySQL.
# ============================================================

# ─── Aplicación ───
APP_NAME="Policlínica Ahuachapaneca API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-policlinica.sistema09.latamname.com
FRONTEND_URL=https://drmauriciohernandez.com,https://policlinica.sistema09.latamname.com

APP_TIMEZONE=America/El_Salvador
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# ─── Base de Datos cPanel (MySQL / MariaDB) ───
# En cPanel generalmente se utiliza 'localhost' o '127.0.0.1'.
# Los nombres de base de datos y usuario suelen llevar el prefijo de tu cuenta cPanel (ej. sistema09_...).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sistema09_policlinica
DB_USERNAME=sistema09_dbuser
DB_PASSWORD=TuPasswordSeguraAqui
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ─── Seguridad / Autenticación ───
BCRYPT_ROUNDS=12
SANCTUM_TOKEN_PREFIX=pcah_
AUTH_TOKEN_EXPIRATION=480

# ─── Reglas de Agenda Médica ───
CITA_RETRASO_PACIENTE_MIN=10
CITA_DURACION_BLOQUE_MIN=30

# ─── Sesión, Caché y Colas ───
# Usamos driver 'file' o 'database' según preferencia del servidor
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# ─── Almacenamiento ───
FILESYSTEM_DISK=local

# ─── Logs ───
# En producción 'daily' rota los logs automáticamente por día
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Correo SMTP nativo de cPanel (Exim) ───
# Servidor de correo de cPanel para el dominio del doctor:
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.drmauriciohernandez.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@drmauriciohernandez.com
MAIL_PASSWORD=TuPasswordDeCorreoEnCpanel
MAIL_FROM_ADDRESS="no-reply@drmauriciohernandez.com"
MAIL_FROM_NAME="Policlínica Ahuachapaneca"
# Nota: Si prefieres STARTTLS en lugar de SSL directo, cambia MAIL_PORT=587 y MAIL_SCHEME=smtp

# ─── API OMS CIE-11 (HU-44) ───
# Producción: ICD_API_URL=https://id.who.int con credenciales oficiales
ICD_API_URL=https://id.who.int
ICD_API_SECURED=true
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=
ICD_PROXY_MINUTOS=15
ICD_PROXY_LIMITE=240
